<h2>Video Saya</h2>

<video id="videoSaya" width="300" controls>
    <source src="video html.mp4" type="video/mp4">
    Browser kamu tidak mendukung video.
</video>

<audio id="audioVideo">
    <source src="audio video.mpeg" type="audio/mpeg">
</audio>

<script>
    const musikPembuka = document.getElementById("musikPembuka");
    const video = document.getElementById("videoSaya");
    const audioVideo = document.getElementById("audioVideo");

    video.addEventListener("play", function () {
        // Menghentikan musik pembuka
        musikPembuka.pause();
        musikPembuka.currentTime = 0;

        // Memulai audio video
        audioVideo.currentTime = 0;
        audioVideo.play();
    });

    video.addEventListener("pause", function () {
        // Menghentikan audio ketika video di-pause
        audioVideo.pause();
    });

    video.addEventListener("ended", function () {
        // Menghentikan audio ketika video selesai
        audioVideo.pause();
        audioVideo.currentTime = 0;
    });
</script>